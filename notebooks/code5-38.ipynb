   ],
   "source": [
    "import torch\n",
    "\n",
    "a = torch.tensor([[1, 0], [0, 1]])\n",
    "b = torch.tensor([[1, 2], [3, 4]])\n",
    "c = a * b # 等同于 torch.mul(a, b)\n",
    "d = a @ b # 等同于 torch.matmul(a, b)\n",
    "print(c)\n",
    "print(d)"
   ]
  }
