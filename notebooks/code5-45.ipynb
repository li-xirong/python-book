   "source": [
    "import torch.nn as nn\n",
    "\n",
    "class SimpleNet(nn.Module):\n",
    "    def __init__(self, vocab_size, num_class=2):\n",
    "        super().__init__()\n",
    "        self.net = nn.Linear(vocab_size, num_class)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.net(x)"
   ]
  }
